{
  "name": "planpal",
  "version": "1.0.0",
  "description": "PlanPal — GenAI Event Planning Assistant",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build:client": "esbuild public/js/app.js --bundle --minify --outfile=public/dist/app.js",
    "build": "npm run build:client && tsc",
    "predev": "npm run build:client",
    "dev": "NODE_ENV=development tsx --env-file=.env src/server.ts",
    "dev:win": "npm run build:client && cross-env NODE_ENV=development tsx --env-file=.env src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "oxlint --deny-warnings && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:lines": "node scripts/check-line-counts.js",
    "check": "npm run check:lines && npm run lint && npm run typecheck && npm run test && npm audit",
    "check:full": "npm run check:lines && npm run lint && npm run typecheck && npm run test:coverage && npm audit",
    "test:browser": "node scripts/verify-real-browser.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
