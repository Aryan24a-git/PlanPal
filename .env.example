# Server configuration
PORT=4000
NODE_ENV=development

# Authentication & Session (Must be at least 32 characters in production)
JWT_SECRET=super-secret-dev-jwt-key-replace-in-prod-minimum-32-chars-length
SESSION_MAX_AGE_SEC=86400

# AI Copilot Provider (options: 'groq', 'mock', 'openai', 'anthropic')
AI_PROVIDER=groq
AI_DAILY_QUOTA_PER_USER=20

# Groq Cloud Configuration (required if AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database Path
DATABASE_URL=./data/planpal.db

# Optional CORS Origin (for production deployment)
# CORS_ORIGIN=https://your-domain.com
